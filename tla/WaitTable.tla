----------------------------- MODULE WaitTable -----------------------------
(* crates/kome の Kernel::wait を実際に動かして生成した。手で書き換えない。
   書き直す: KOME_UPDATE_GOLDEN=1 cargo test -p kome the_tla_wait_table_is_the_kernel *)
EXTENDS TLC

\* (a の数, b の数, 対象の列, 条件) から (判定, 消費後の a の数, 消費後の b の数) への表。
WaitDecide ==
    (<<0, 0, <<"a">>, "Any">> :> <<"Blocked", 0, 0>>) @@
    (<<0, 1, <<"a">>, "Any">> :> <<"Blocked", 0, 1>>) @@
    (<<0, 2, <<"a">>, "Any">> :> <<"Blocked", 0, 2>>) @@
    (<<1, 0, <<"a">>, "Any">> :> <<"First", 0, 0>>) @@
    (<<1, 1, <<"a">>, "Any">> :> <<"First", 0, 1>>) @@
    (<<1, 2, <<"a">>, "Any">> :> <<"First", 0, 2>>) @@
    (<<2, 0, <<"a">>, "Any">> :> <<"First", 1, 0>>) @@
    (<<2, 1, <<"a">>, "Any">> :> <<"First", 1, 1>>) @@
    (<<2, 2, <<"a">>, "Any">> :> <<"First", 1, 2>>) @@
    (<<0, 0, <<"b">>, "Any">> :> <<"Blocked", 0, 0>>) @@
    (<<0, 1, <<"b">>, "Any">> :> <<"First", 0, 0>>) @@
    (<<0, 2, <<"b">>, "Any">> :> <<"First", 0, 1>>) @@
    (<<1, 0, <<"b">>, "Any">> :> <<"Blocked", 1, 0>>) @@
    (<<1, 1, <<"b">>, "Any">> :> <<"First", 1, 0>>) @@
    (<<1, 2, <<"b">>, "Any">> :> <<"First", 1, 1>>) @@
    (<<2, 0, <<"b">>, "Any">> :> <<"Blocked", 2, 0>>) @@
    (<<2, 1, <<"b">>, "Any">> :> <<"First", 2, 0>>) @@
    (<<2, 2, <<"b">>, "Any">> :> <<"First", 2, 1>>) @@
    (<<0, 0, <<"a", "b">>, "Any">> :> <<"Blocked", 0, 0>>) @@
    (<<0, 1, <<"a", "b">>, "Any">> :> <<"Second", 0, 0>>) @@
    (<<0, 2, <<"a", "b">>, "Any">> :> <<"Second", 0, 1>>) @@
    (<<1, 0, <<"a", "b">>, "Any">> :> <<"First", 0, 0>>) @@
    (<<1, 1, <<"a", "b">>, "Any">> :> <<"First", 0, 1>>) @@
    (<<1, 2, <<"a", "b">>, "Any">> :> <<"First", 0, 2>>) @@
    (<<2, 0, <<"a", "b">>, "Any">> :> <<"First", 1, 0>>) @@
    (<<2, 1, <<"a", "b">>, "Any">> :> <<"First", 1, 1>>) @@
    (<<2, 2, <<"a", "b">>, "Any">> :> <<"First", 1, 2>>) @@
    (<<0, 0, <<"b", "a">>, "Any">> :> <<"Blocked", 0, 0>>) @@
    (<<0, 1, <<"b", "a">>, "Any">> :> <<"First", 0, 0>>) @@
    (<<0, 2, <<"b", "a">>, "Any">> :> <<"First", 0, 1>>) @@
    (<<1, 0, <<"b", "a">>, "Any">> :> <<"Second", 0, 0>>) @@
    (<<1, 1, <<"b", "a">>, "Any">> :> <<"First", 1, 0>>) @@
    (<<1, 2, <<"b", "a">>, "Any">> :> <<"First", 1, 1>>) @@
    (<<2, 0, <<"b", "a">>, "Any">> :> <<"Second", 1, 0>>) @@
    (<<2, 1, <<"b", "a">>, "Any">> :> <<"First", 2, 0>>) @@
    (<<2, 2, <<"b", "a">>, "Any">> :> <<"First", 2, 1>>) @@
    (<<0, 0, <<"a">>, "All">> :> <<"Blocked", 0, 0>>) @@
    (<<0, 1, <<"a">>, "All">> :> <<"Blocked", 0, 1>>) @@
    (<<0, 2, <<"a">>, "All">> :> <<"Blocked", 0, 2>>) @@
    (<<1, 0, <<"a">>, "All">> :> <<"All", 0, 0>>) @@
    (<<1, 1, <<"a">>, "All">> :> <<"All", 0, 1>>) @@
    (<<1, 2, <<"a">>, "All">> :> <<"All", 0, 2>>) @@
    (<<2, 0, <<"a">>, "All">> :> <<"All", 1, 0>>) @@
    (<<2, 1, <<"a">>, "All">> :> <<"All", 1, 1>>) @@
    (<<2, 2, <<"a">>, "All">> :> <<"All", 1, 2>>) @@
    (<<0, 0, <<"b">>, "All">> :> <<"Blocked", 0, 0>>) @@
    (<<0, 1, <<"b">>, "All">> :> <<"All", 0, 0>>) @@
    (<<0, 2, <<"b">>, "All">> :> <<"All", 0, 1>>) @@
    (<<1, 0, <<"b">>, "All">> :> <<"Blocked", 1, 0>>) @@
    (<<1, 1, <<"b">>, "All">> :> <<"All", 1, 0>>) @@
    (<<1, 2, <<"b">>, "All">> :> <<"All", 1, 1>>) @@
    (<<2, 0, <<"b">>, "All">> :> <<"Blocked", 2, 0>>) @@
    (<<2, 1, <<"b">>, "All">> :> <<"All", 2, 0>>) @@
    (<<2, 2, <<"b">>, "All">> :> <<"All", 2, 1>>) @@
    (<<0, 0, <<"a", "b">>, "All">> :> <<"Blocked", 0, 0>>) @@
    (<<0, 1, <<"a", "b">>, "All">> :> <<"Blocked", 0, 1>>) @@
    (<<0, 2, <<"a", "b">>, "All">> :> <<"Blocked", 0, 2>>) @@
    (<<1, 0, <<"a", "b">>, "All">> :> <<"Blocked", 1, 0>>) @@
    (<<1, 1, <<"a", "b">>, "All">> :> <<"All", 0, 0>>) @@
    (<<1, 2, <<"a", "b">>, "All">> :> <<"All", 0, 1>>) @@
    (<<2, 0, <<"a", "b">>, "All">> :> <<"Blocked", 2, 0>>) @@
    (<<2, 1, <<"a", "b">>, "All">> :> <<"All", 1, 0>>) @@
    (<<2, 2, <<"a", "b">>, "All">> :> <<"All", 1, 1>>) @@
    (<<0, 0, <<"b", "a">>, "All">> :> <<"Blocked", 0, 0>>) @@
    (<<0, 1, <<"b", "a">>, "All">> :> <<"Blocked", 0, 1>>) @@
    (<<0, 2, <<"b", "a">>, "All">> :> <<"Blocked", 0, 2>>) @@
    (<<1, 0, <<"b", "a">>, "All">> :> <<"Blocked", 1, 0>>) @@
    (<<1, 1, <<"b", "a">>, "All">> :> <<"All", 0, 0>>) @@
    (<<1, 2, <<"b", "a">>, "All">> :> <<"All", 0, 1>>) @@
    (<<2, 0, <<"b", "a">>, "All">> :> <<"Blocked", 2, 0>>) @@
    (<<2, 1, <<"b", "a">>, "All">> :> <<"All", 1, 0>>) @@
    (<<2, 2, <<"b", "a">>, "All">> :> <<"All", 1, 1>>)
